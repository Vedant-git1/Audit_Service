# Application
NODE_ENV=development
PORT=3000
SERVICE_NAME=audit-service
LOG_LEVEL=info

# Audit Service-owned PostgreSQL database
DATABASE_URL=postgresql://audit_user:replace-with-local-password@localhost:5433/resolve_audit?schema=public
POSTGRES_DB=resolve_audit
POSTGRES_USER=audit_user
POSTGRES_PASSWORD=replace-with-local-password

# Resolve JWT verification and revocation checking.
REDIS_URL=redis://localhost:6379
JWT_ISSUER=resolve-authentication-service
JWT_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# Optional; configure only when Authentication issues an audience claim.
# JWT_AUDIENCE=resolve-api

# Kafka is disabled for local development unless the shared Resolve broker is available.
KAFKA_ENABLED=false
KAFKA_FROM_BEGINNING=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=audit-service
KAFKA_CONSUMER_GROUP_ID=resolve-audit-service
# Source of truth: Resolve_Documentation/Contracts/kafka.md
KAFKA_TOPICS=resolve.case.created,resolve.case.assigned,resolve.case.statuschanged,resolve.case.resolved,resolve.task.created,resolve.task.completed,resolve.document.uploaded,resolve.document.scanned,resolve.approval.requested,resolve.approval.completed
